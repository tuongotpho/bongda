# Chép file này thành .env rồi điền. Để trống = chạy chế độ thử (lưu trên trình duyệt).
# Lấy ở Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration.
# (Cấu hình web Firebase không phải mật khẩu — bảo vệ dữ liệu nằm ở firestore.rules.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Email thủ quỹ được sửa dữ liệu, cách nhau dấu phẩy. Phải khớp danh sách trong firestore.rules.
VITE_ADMIN_EMAILS=vietthanh228@gmail.com
